# ==========================================
# Application
# ==========================================
# PORT: Nest listen port inside the process / container.
# APP_PORT: host port Docker Compose maps to PORT (${APP_PORT}:${PORT}).

PORT=5000
APP_PORT=5001


# ==========================================
# PostgreSQL
# ==========================================
# Credentials for the Compose Postgres image.
# POSTGRES_PORT is the host mapping to container 5432.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=myapp
POSTGRES_PORT=5433


# ==========================================
# Database URL
# ==========================================
# Prisma connection string.
# Local NestJS -> localhost:POSTGRES_PORT -> Postgres container.
# The app service in docker-compose.yaml overrides this to postgres:5432.

DATABASE_URL=postgresql://postgres:password123@localhost:5433/myapp?schema=public


# ==========================================
# JWT
# ==========================================
# Signs access and refresh tokens. Use at least 32 random characters in production.

JWT_SECRET=replace-with-at-least-32-random-characters


# ==========================================
# Agora (video calls)
# ==========================================
# AGORA_APP_ID is returned to clients. AGORA_APP_CERTIFICATE stays on the server.
# AGORA_TOKEN_TTL_SECONDS: token lifetime, 60–86400 (default 3600).

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=3600


# ==========================================
# Seed users (prisma db seed)
# ==========================================
# Optional overrides for the seeded admin, customer, and technician accounts.

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASSWORD=replace-with-a-strong-customer-password
TECHNICIAN_EMAIL=technician@example.com
TECHNICIAN_PASSWORD=replace-with-a-strong-technician-password


# ==========================================
# Stripe
# ==========================================
# Server-only. Never expose these to a web or mobile client.
# STRIPE_CURRENCY default is cad. STRIPE_WEBHOOK_TOLERANCE_SECONDS default is 300.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cad
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300


# ==========================================
# Checkout redirects
# ==========================================
# Absolute URLs Stripe sends the browser to after hosted Checkout.

FRONTEND_PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
FRONTEND_PAYMENT_CANCEL_URL=http://localhost:3000/payment/failed


# ==========================================
# Tax
# ==========================================
# Decimal rate applied to shop and service totals (example: Quebec 14.975%).

TAX_RATE=0.14975


# ==========================================
# Client / CORS
# ==========================================
# CORS_ORIGIN: comma-separated browser origins allowed to call this API.
# CLIENT_APP_URL: storefront origin for operators (not read by Nest at runtime).

CLIENT_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000


# ==========================================
# Email (Brevo)
# ==========================================
# Signup verification OTPs, password-reset OTPs, and the public contact form.
# Sign up at https://www.brevo.com and create a transactional email API key.
# MAIL_FROM must be a verified sender. MAIL_TO is the contact-form fallback
# recipient when business support email is unset.

BREVO_API_KEY=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Central Care
MAIL_TO=


# ==========================================
# Cloudinary
# ==========================================
# Avatars, product images, service/chat media, equipment photos, business logo,
# landing hero image, and return labels.
# Sign up at https://cloudinary.com and copy credentials from your dashboard.
# CLOUDINARY_UPLOAD_PRESET: unsigned preset name (leave blank for signed uploads).

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Migrations run at startup; demo seeding is disabled by default.
RUN_SEED=false
